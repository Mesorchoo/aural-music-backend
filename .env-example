
LISTEN_PORT=3000
MUSIC_LIBRARY_PATH="/srv/music/Library"
ALLOWED_MUSIC_FILE_EXTENSIONS=".mp3,.flac,.opus"
SECURITY_TOKEN="Sn9Ype7_DONT_USE_THIS_GENERATE_YOUR_OWN_cSgtF7roDH"

# Optional: where playlist JSON files are stored (defaults to MUSIC_LIBRARY_PATH/.playlists)
# PLAYLISTS_PATH="/srv/music/Playlists"

# Optional: Dolby (E-AC-3) files are transcoded to FLAC with ffmpeg; set these if it isn't on the PATH
# FFMPEG_PATH="/usr/bin/ffmpeg"
# FFPROBE_PATH="/usr/bin/ffprobe"
# Optional: where transcoded copies are stored (defaults to MUSIC_LIBRARY_PATH/.transcoded)
# TRANSCODE_PATH="/srv/music/Transcoded"

# Optional: fetch missing album art from Spotify and save it as album_art.jpg in the album folder
# SPOTIFY_CLIENT_ID=""
# SPOTIFY_CLIENT_SECRET=""
